# Copy to .env next to compose.yaml and fill in.
# Lines starting with # are off; remove the # to use one.

# Your time zone (calendar and reminders, from later phases)
TZ=Europe/Stockholm

# Who owns the files in the data folder (run `id` on the server to see yours)
PUID=1000
PGID=1000

# Where Noterat keeps everything (back this folder up)
NOTERAT_DATA=./data
# The port on the server; 127.0.0.1:3300 keeps it off your network (the https profile doesn't need it)
NOTERAT_PORT=3300

# The extras to run, so a plain `docker compose up -d` starts them: https, gpu (speech to text)
# COMPOSE_PROFILES=https

# The address people use, once it has HTTPS (share links)
# PUBLIC_URL=https://noterat.example.com

# https profile (Caddy): your domain, pointing at your home IP (ports 80 and 443 forwarded)
# NOTERAT_DOMAIN=noterat.example.com

# Behind a proxy that puts the visitor's address in a header: that header
# (SWAG and Nginx Proxy Manager: x-real-ip; Caddy: x-forwarded-for; Cloudflare Tunnel: cf-connecting-ip)
# Only set it when Noterat can't be reached except through that proxy.
# TRUSTED_IP_HEADER=x-real-ip

# Speech to text for voice memos (the gpu profile: the worker, on an Nvidia GPU): a long random string,
# e.g. from `openssl rand -hex 32`. Noterat and the worker both get it; without it, memos aren't transcribed.
# WORKER_TOKEN=
