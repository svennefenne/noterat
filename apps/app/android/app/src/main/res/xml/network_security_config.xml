<?xml version="1.0" encoding="utf-8"?>
<!-- A Noterat server at home can be plain http on the local network (http://192.168.1.10:3300).
     Over the internet, use https (a reverse proxy with a certificate). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
