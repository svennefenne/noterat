<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- NoteratApplication starts Firebase with the server's settings as the process starts (decision 12) -->
    <application
        android:name=".NoteratApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- noterat:// links, as the launcher's shortcuts and the home-screen widget open them
                 (noterat://memos?record=1: src/lib/deepLinks.ts). Not BROWSABLE: a web page can't open
                 them, so it can't start a recording or the scanner. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="noterat" />
            </intent-filter>

            <!-- the launcher's shortcuts (a long press on the icon) -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

        </activity>

        <!-- the quick-actions widget for the home screen -->
        <receiver
            android:name=".QuickActionsWidget"
            android:exported="false"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quick_actions_info" />
        </receiver>

        <!-- push (decision 12): the channel, icon and colour of a push shown while the app isn't in front -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="noterat" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_noterat" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/push_accent" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- the camera app, for "Take a photo" (since Android 11 an app sees only what it says it looks for;
         without this the WebView falls back to picking a file). No CAMERA permission: the camera app takes it. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- voice memos: the microphone (asked for the first time someone records), and the WebView's audio settings -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- the calendar: the phone's own calendars, read and shown beside Noterat's (asked for when turned on) -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- push notifications (Android 13+ asks; the app asks once push is set up on the server) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- updates from the household's own server (decision 16): Android's installer, opened on a downloaded APK
         (Android asks the person every time, and the first time for the right to) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
</manifest>
